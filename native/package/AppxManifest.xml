<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifeste du paquet KaneMode.
  - windows.gamingApp + la capacité gamingHome : KaneMode apparaît dans
    Paramètres > Jeux > Mode Xbox > « Choisir l'application d'accueil ».
  - Widget Game Bar (application KaneMode.Widget.exe, UWP exigée par la Game Bar) : l'interface de
    KaneMode (ui\widget.html) dans un WebView2 de WinUI 2, par-dessus les jeux. Dépend du runtime
    C++ des applis UWP (VCLibs) et de WinUI 2.8 (installé par l'installateur s'il manque). Les
    composants de Microsoft (Game Bar, WebView2 pour UWP) sont déclarés plus bas.
  - Virtualisation désactivée : l'app et les jeux qu'elle lance écrivent dans les vrais
    dossiers (sauvegardes, réglages), pas dans un espace privé du paquet.
  build.ps1 y remplace la version et la liste des classes WebView2 (marqueurs entre doubles
  soulignés) ; avec -NoWidget, tout ce qui est entre les marqueurs WIDGET est retiré.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap4="http://schemas.microsoft.com/appx/manifest/uap/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap uap3 uap4 rescap desktop6">

  <Identity Name="KaneMode" Publisher="CN=KaneMode" Version="__VERSION__" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>KaneMode</DisplayName>
    <PublisherDisplayName>KaneMode</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26200.0" />
    <!-- WIDGET -->
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.30035.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
    <PackageDependency Name="Microsoft.UI.Xaml.2.8" MinVersion="8.2310.30001.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
    <!-- /WIDGET -->
  </Dependencies>

  <Resources>
    <Resource Language="fr-FR" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="KaneMode.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="KaneMode"
        Description="Interface console pour Windows : tous vos jeux, boutiques et émulateurs à la manette."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B0E13" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="windows.gamingApp" Id="App" DisplayName="KaneMode"
                             Description="Interface console KaneMode" PublicFolder="Public" />
        </uap3:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="kanemode" />
        </uap:Extension>
      </Extensions>
    </Application>
    <!-- WIDGET -->
    <!-- Widget Game Bar : pas d'entrée dans le menu Démarrer, il s'ouvre dans la Game Bar -->
    <Application Id="Widget" Executable="KaneMode.Widget.exe" EntryPoint="KaneModeWidget.App">
      <uap:VisualElements
        DisplayName="KaneMode"
        Description="Widget Game Bar de KaneMode"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none">
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B0E13" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="microsoft.gameBarUIExtension" Id="KaneModeWidget" DisplayName="KaneMode"
                             Description="Accès rapide de KaneMode par-dessus les jeux" PublicFolder="GameBar">
            <uap3:Properties>
              <GameBarWidget Type="Standard">
                <HomeMenuVisible>true</HomeMenuVisible>
                <PinningSupported>true</PinningSupported>
                <ActivateAfterInstall>true</ActivateAfterInstall>
                <FavoriteAfterInstall>true</FavoriteAfterInstall>
                <Window>
                  <Size>
                    <Height>720</Height>
                    <Width>400</Width>
                    <MinHeight>360</MinHeight>
                    <MinWidth>340</MinWidth>
                    <MaxHeight>1200</MaxHeight>
                    <MaxWidth>640</MaxWidth>
                  </Size>
                  <ResizeSupported>
                    <Horizontal>true</Horizontal>
                    <Vertical>true</Vertical>
                  </ResizeSupported>
                </Window>
              </GameBarWidget>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
    <!-- /WIDGET -->
  </Applications>

  <!-- WIDGET -->
  <Extensions>
    <!-- Composant Game Bar de Microsoft (classes et marshaling, copiés du readme du NuGet) -->
    <Extension Category="windows.activatableClass.inProcessServer">
