      </ProxyStub>
    </Extension>
    <!-- Composant WebView2 pour les applis UWP (NuGet Microsoft.Web.WebView2), utilisé par le WebView2 de
         WinUI 2. Dans un sous-dossier : même nom de fichier que la bibliothèque .NET de KaneMode.exe. -->
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>webview2-uwp\Microsoft.Web.WebView2.Core.dll</Path>
__WEBVIEW2_CLASSES__
      </InProcessServer>
    </Extension>
  </Extensions>
  <!-- /WIDGET -->

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <uap4:CustomCapability Name="Microsoft.appCategory.gamingHome_8wekyb3d8bbwe" />
  </Capabilities>
</Package>
