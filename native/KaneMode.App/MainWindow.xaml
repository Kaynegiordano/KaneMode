<Window x:Class="KaneMode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="KaneMode"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#0B0E13"
        Icon="pack://application:,,,/kanemode.png">
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#0B0E13" Visibility="Hidden" />

        <!-- Écran d'attente, le temps que l'hôte et l'interface démarrent -->
        <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/kanemode.png" Width="88" Height="88" />
            <TextBlock x:Name="Status" Text="Démarrage…" Foreground="#8C95A3" FontSize="18"
                       FontFamily="Segoe UI Variable Text, Segoe UI" Margin="0,22,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="720" />
            <TextBlock x:Name="Hint" Foreground="#5E6673" FontSize="14" Margin="0,14,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"
                       Text="Échap ou B : quitter · Entrée ou A : réessayer" />
        </StackPanel>
    </Grid>
</Window>
